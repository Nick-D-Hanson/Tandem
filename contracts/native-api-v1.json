{
  "contractVersion": 1,
  "apiVersion": "v1",
  "mediaType": "application/json",
  "endpoints": {
    "/api/v1/me": {
      "method": "GET",
      "authentication": "Neon Auth session",
      "cache": "private, no-store",
      "responses": {
        "200": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "data": {
              "type": "object",
              "properties": {
                "apiVersion": {
                  "type": "string",
                  "const": "v1"
                },
                "generatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                },
                "user": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "email": {
                      "type": "string",
                      "format": "email",
                      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                    },
                    "displayName": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "avatarUrl": {
                      "anyOf": [
                        {
                          "type": "string",
                          "format": "uri"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "email",
                    "displayName",
                    "avatarUrl"
                  ],
                  "additionalProperties": false
                },
                "workspace": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "timezone": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "timezone"
                  ],
                  "additionalProperties": false
                },
                "members": {
                  "minItems": 1,
                  "maxItems": 2,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "userId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "displayName": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "avatarUrl": {
                        "anyOf": [
                          {
                            "type": "string",
                            "format": "uri"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "userId",
                      "displayName",
                      "avatarUrl"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "apiVersion",
                "generatedAt",
                "user",
                "workspace",
                "members"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "data"
          ],
          "additionalProperties": false
        },
        "401": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "VALIDATION_ERROR",
                    "UNAUTHORIZED",
                    "NOT_FOUND",
                    "CONFLICT",
                    "RATE_LIMITED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "additionalProperties": false
        },
        "404": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "VALIDATION_ERROR",
                    "UNAUTHORIZED",
                    "NOT_FOUND",
                    "CONFLICT",
                    "RATE_LIMITED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "additionalProperties": false
        },
        "500": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean",
              "const": false
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "VALIDATION_ERROR",
                    "UNAUTHORIZED",
                    "NOT_FOUND",
                    "CONFLICT",
                    "RATE_LIMITED",
                    "INTERNAL_ERROR"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      }
    }
  }
}
